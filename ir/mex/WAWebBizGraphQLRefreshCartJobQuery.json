    "document": "# persisted document WAWebBizGraphQLRefreshCartJobQuery\nquery BizGraphQLRefreshCartJobQuery(\n  $request\n) {\n  xwa_checkout_refresh_cart(request: $request) {  # XWACheckoutRefreshCartResponseSuccess\n    cart {  # XWACheckoutRefreshCartResponseSuccessProductList\n      products {  # [XWACatalogProduct]\n        is_hidden\n        availability\n        product_availability\n        status_info {  # XWAProductCatalogProductStatusInfo\n          reject_reason\n          status\n          can_appeal\n          commerce_url\n        }\n        image_fetch_status\n        price\n        currency\n        retailer_id\n        name\n        description\n        url\n        id\n        media {  # XWAProductCatalogProductMedia\n          images {  # [XWAProductCatalogProductMediaImage]\n            id\n            original_dimensions {  # XWAProductCatalogProductMediaImageOriginalDimensions\n              height\n              width\n            }\n          }\n          videos {  # [XWAProductCatalogProductMediaVideo]\n            thumbnail_url\n            original_video_url\n            id\n          }\n        }\n        sale_price {  # XWAProductCatalogProductSalePrice\n          price\n          start_date\n          end_date\n        }\n        max_available\n        belongs_to\n        status\n        compliance_category\n        compliance_info {  # XWAProductCatalogProductComplianceInfo\n          country_code_origin\n          importer_name\n          importer_address {  # XWAProductCatalogProductComplianceInfoImporterAddress\n            street1\n            street2\n            city\n            region\n            postal_code\n            country_code\n          }\n        }\n        variant_info {  # XWACatalogProductVariantInfo\n          types {  # [XWACatalogVariantTypes]\n            name\n            options {  # [XWACatalogVariantTypeOption]\n              value\n              thumbnail_media {  # XWAProductCatalogProductMediaImage\n                original_dimensions {  # XWAProductCatalogProductMediaImageOriginalDimensions\n                  width\n                  height\n                }\n                original_image_url\n                id\n              }\n            }\n          }\n          listing_details {  # XWACatalogVariantListingDetails\n            description\n            multi_price\n            lowest_price\n          }\n          variant_properties {  # [XWACatalogVariantProperties]\n            value\n            name\n          }\n          availability {  # XWACatalogVariantAvailability\n            listing {  # [XWAVariantAvailabilityListing]\n              is_available\n              product_id\n              options {  # [XWAVariantAvailabilityListingOption]\n                name\n                value\n              }\n            }\n          }\n        }\n      }\n      price_details {  # XWACheckoutPriceDetails\n        total_amount\n        subtotal_amount\n        currency\n        price_status\n      }\n    }\n  }\n}\n"
