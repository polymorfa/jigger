    "root_field": "xwa2_channel_enforcements",
    "document": "# persisted document 27835373536068060\nquery MexFetchNewsletterEnforcementsJobQuery(\n  $newsletter_id\n  $locale\n) {\n  xwa2_channel_enforcements(channel_id: $newsletter_id, locale: $locale) {  # XWA2ChannelEnforcementsResponse\n    admin_profiles {  # [XWA2BaseEnforcementData]\n      enforcement_creation_time\n      appeal_creation_time\n      appeal_state\n      enforcement_violation_category\n      enforcement_source\n      enforcement_id\n      appeal_reason_options {  # [XWA2EnforcementAppealReasonOption]\n        reason\n        label\n      }\n      enforcement_extra_data {  # XWA2EnforcementExtraData\n        ip_violation_report_data {  # XWA2IPViolationReportData\n          report_fbid\n          appeal_form_url\n          reporter_email\n          reporter_name\n        }\n        enforcement_target_data {\n          __typename\n          ... on XWA2NewsletterAdminProfile {\n            id\n            name\n            picture {  # XWA2Picture\n              id\n              direct_path\n            }\n          }\n        }\n      }\n      enforcement_policy_information {  # XWA2EnforcementPolicyInformation\n        overview\n        headline\n        subtitle\n        explanation\n        admin_disclaimer\n      }\n    }\n    profile_picture_deletions {  # [XWA2BaseEnforcementData]\n      enforcement_creation_time\n      appeal_creation_time\n      appeal_state\n      enforcement_violation_category\n      enforcement_source\n      enforcement_id\n      appeal_reason_options {  # [XWA2EnforcementAppealReasonOption]\n        reason\n        label\n      }\n      enforcement_extra_data {  # XWA2EnforcementExtraData\n        ip_violation_report_data {  # XWA2IPViolationReportData\n          report_fbid\n          appeal_form_url\n          reporter_email\n          reporter_name\n        }\n      }\n      enforcement_policy_information {  # XWA2EnforcementPolicyInformation\n        overview\n        headline\n        subtitle\n        explanation\n        admin_disclaimer\n      }\n    }\n    suspensions {  # [XWA2BaseEnforcementData]\n      appeal_creation_time\n      enforcement_creation_time\n      appeal_state\n      enforcement_violation_category\n      enforcement_id\n      enforcement_source\n      appeal_reason_options {  # [XWA2EnforcementAppealReasonOption]\n        reason\n        label\n      }\n      enforcement_extra_data {  # XWA2EnforcementExtraData\n        ip_violation_report_data {  # XWA2IPViolationReportData\n          report_fbid\n          appeal_form_url\n          reporter_email\n          reporter_name\n        }\n        enforcement_target_data {\n          __typename\n          ... on XWA2ChannelServerMsgData {\n            server_msg_id\n          }\n          ... on XWA2ChannelStatusData {\n            server_id\n          }\n          ... on XWA2NewsletterAdminProfile {\n            id\n          }\n        }\n        appeal_extra_data {  # XWA2AppealExtraData\n          appeal_form_url\n        }\n      }\n      enforcement_policy_information {  # XWA2EnforcementPolicyInformation\n        overview\n        headline\n        subtitle\n        explanation\n        admin_disclaimer\n      }\n    }\n    violating_messages {  # [XWA2ViolatingMessagesEnforcementData]\n      base_enforcement_data {  # XWA2BaseEnforcementData\n        enforcement_creation_time\n        appeal_creation_time\n        appeal_state\n        enforcement_id\n        enforcement_violation_category\n        enforcement_source\n        appeal_reason_options {  # [XWA2EnforcementAppealReasonOption]\n          reason\n          label\n        }\n        enforcement_extra_data {  # XWA2EnforcementExtraData\n          ip_violation_report_data {  # XWA2IPViolationReportData\n            report_fbid\n            appeal_form_url\n            reporter_email\n            reporter_name\n          }\n        }\n        enforcement_policy_information {  # XWA2EnforcementPolicyInformation\n          overview\n          headline\n          subtitle\n          explanation\n          admin_disclaimer\n        }\n      }\n      content_data {\n        __typename\n        ... on XWA2ChannelServerMsgData {\n          server_msg_id\n        }\n        ... on XWA2ChannelStatusData {\n          server_id\n        }\n      }\n    }\n    geosuspensions {  # [XWA2GeosuspendedEnforcementData]\n      base_enforcement_data {  # XWA2BaseEnforcementData\n        enforcement_creation_time\n        appeal_creation_time\n        appeal_state\n        enforcement_id\n        enforcement_violation_category\n        enforcement_source\n        appeal_reason_options {  # [XWA2EnforcementAppealReasonOption]\n          reason\n          label\n        }\n        enforcement_extra_data {  # XWA2EnforcementExtraData\n          ip_violation_report_data {  # XWA2IPViolationReportData\n            report_fbid\n            appeal_form_url\n            reporter_email\n            reporter_name\n          }\n          enforcement_target_data {\n            __typename\n            ... on XWA2ChannelServerMsgData {\n              server_msg_id\n            }\n            ... on XWA2ChannelStatusData {\n              server_id\n            }\n            ... on XWA2NewsletterAdminProfile {\n              id\n            }\n          }\n          appeal_extra_data {  # XWA2AppealExtraData\n            appeal_form_url\n          }\n          enforcing_entity_data {  # XWA2EnforcingEntityData\n            name\n          }\n          enforcement_origin_workflow\n          enforcement_origin_legal_basis\n        }\n        enforcement_policy_information {  # XWA2EnforcementPolicyInformation\n          overview\n          headline\n          subtitle\n          explanation\n          admin_disclaimer\n        }\n      }\n      country_codes\n    }\n  }\n}\n"
