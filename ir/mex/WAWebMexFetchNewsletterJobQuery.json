    "document": "# persisted document 27456920720571478\nquery MexFetchNewsletterJobQuery(\n  $input\n  $fetch_viewer_metadata\n  $fetch_full_image\n  $fetch_creation_time\n  $fetch_wamo_sub\n  $fetch_status_metadata\n  $fetch_pinned_messages\n) {\n  xwa2_newsletter(input: $input) {  # XWA2Newsletter\n    id\n    state {  # XWA2NewsletterState\n      type\n    }\n    thread_metadata {  # XWA2NewsletterThreadMetadata\n      @include(if: $fetch_creation_time) {\n        creation_time\n      }\n      name {  # XWA2NewsletterName\n        id\n        text\n        update_time\n      }\n      @include(if: $fetch_full_image) {\n        picture(type: \"IMAGE\") {  # XWA2Picture\n          id\n          type\n          direct_path\n        }\n      }\n      preview: picture(type: \"PREVIEW\") {  # XWA2Picture\n        id\n        type\n        direct_path\n      }\n      description {  # XWA2NewsletterDescription\n        id\n        text\n        update_time\n      }\n      invite\n      handle\n      subscribers_count\n      verification\n      settings {  # XWA2NewsletterThreadSettings\n        reaction_codes {  # XWA2NewsletterReactionCodesSetting\n          value\n        }\n      }\n      @include(if: $fetch_wamo_sub) {\n        wamo_sub {  # XWA2NewsletterWamoSubMetadata\n          plan_id\n        }\n      }\n      @include(if: $fetch_pinned_messages) {\n        pinned_messages {  # [XWA2NewsletterPinnedMessage]\n          message_id\n          expiry_ts\n        }\n      }\n    }\n    @include(if: $fetch_viewer_metadata) {\n      viewer_metadata {  # XWA2NewsletterViewerMetadata\n        settings {  # [XWA2NewsletterUserSetting]\n          type\n          value\n        }\n        role\n        @include(if: $fetch_wamo_sub) {\n          wamo_sub_status\n        }\n      }\n    }\n    @include(if: $fetch_status_metadata) {\n      status_metadata {  # XWA2NewsletterStatusMetadata\n        last_status_server_id\n        last_status_sent_time\n      }\n    }\n  }\n}\n"
