    "root_field": "xwa2_fetch_wa_users",
    "document": "# persisted document 29829202653362039\nquery MexUsyncQuery(\n  $input\n  $include_username\n  $include_about_status\n  $include_country_code\n) {\n  xwa2_fetch_wa_users(input: $input) {  # list\n    __typename\n    jid\n    @include(if: $include_country_code) {\n      country_code\n    }\n    @include(if: $include_username) {\n      username_info {\n        __typename\n        ... on XWA2Username {\n          username\n          state\n          timestamp\n          pin\n        }\n        ... on XWA2ResponseStatus {\n          status\n        }\n      }\n    }\n    @include(if: $include_about_status) {\n      about_status_info {\n        __typename\n        ... on XWA2AboutStatus {\n          text\n          timestamp\n        }\n        ... on XWA2ResponseStatus {\n          status\n        }\n      }\n    }\n    ... on XWA2User {\n      id\n    }\n  }\n}\n"
