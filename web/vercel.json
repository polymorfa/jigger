{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": {
      "data": false,
      "artifacts": false
    }
  },
  "rewrites": [
    {
      "source": "/source/:name+",
      "destination": "/source/_"
    },
    {
      "source": "/fact/:id+",
      "destination": "/fact/_"
    },
    {
      "source": "/ab/:slug+",
      "destination": "/ab/_"
    },
    {
      "source": "/wam/:slug+",
      "destination": "/wam/_"
    },
    {
      "source": "/iq/:slug+",
      "destination": "/iq/_"
    },
    {
      "source": "/mex/:slug+",
      "destination": "/mex/_"
    },
    {
      "source": "/sig/:slug+",
      "destination": "/sig/_"
    },
    {
      "source": "/proto/:slug+",
      "destination": "/proto/_"
    },
    {
      "source": "/enum/:slug+",
      "destination": "/enum/_"
    },
    {
      "source": "/appstate/:slug+",
      "destination": "/appstate/_"
    }
  ]
}
